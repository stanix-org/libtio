#!/bin/sh
. "$(dirname "$0" )/tconf.sh"

OPTIONS="MULTI_LANGUAGES"
: ${MULTI_LANGUAGES:="yes"}
tconf_init "$@"

tconf_search_cc "$HOST"
tconf_require "C compiler" "$CC"
tconf_find_os

if ! tconf_check_library "$CC" "utils" ; then
	tconf_log "libutils is required, download it at https://github.com/stanix-org/libutils"
fi

tconf_gen_makefiles "$SRCDIR/Makefile.in"

tconf_fini
